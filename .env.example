# Copy this file to .env and fill in the values.
# With Gmail you need an app password, not the account password:
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# CVSS score from which a CVE moves to level 2
CVSS_ALERT_THRESHOLD=9.0
# Number of entries read from each RSS feed
MAX_ENTRIES_PER_FEED=5

# EPSS score from which a CVE moves to level 2, whatever its CVSS
EPSS_ALERT_THRESHOLD=0.1

# Optional NVD key (https://nvd.nist.gov/developers/request-an-api-key), speeds up CVSS lookups
NVD_API_KEY=

# CVEs from bulletins newer than this many days are re-assessed on each run (EPSS, KEV)
ALERT_WINDOW_DAYS=30
